{
    "$schema": "appsettings-schema.json",
    "AWS": {
        "ServiceURL": "http://localhost:8334",
        "ForcePathStyle": true
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [{"Name": "Console"}]
                }
            }
        ]
    },
    "Umbraco": {
        "Storage": {
            "AWSS3": {
                "Media": {
                    "BucketName": "methodconf-local"
                }
            }
        },
        "CMS": {
            "Content": {
                "MacroErrors": "Throw"
            },
            "Hosting": {
                "Debug": true
            },
            "Global": {
                "TimeOut": "3.00:00:00",
                "DisableElectionForSingleServer": true,
                "DistributedLockingMechanism": "SqliteDistributedLockingMechanism",
                "Smtp": {
                    "From": "Method Conf <website@email.sgf.dev>",
                    "Host": "localhost",
                    "Port": 1025
                }
            },
            "RuntimeMinification": {
                "UseInMemoryCache": true,
                "CacheBuster": "Timestamp"
            },
            "Runtime": {
                "Mode": "Development"
            },
            "ModelsBuilder": {
                "ModelsMode": "SourceCodeAuto"
            }
        }
    }
}
